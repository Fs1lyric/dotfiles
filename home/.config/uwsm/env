# Session environment for Hyprland (uwsm sources this before starting the compositor).
export TERMINAL=xdg-terminal-exec
export EDITOR=nvim
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) PATH="$HOME/.local/bin:$PATH" ;; esac
case ":$PATH:" in *":$HOME/.local/share/mise/shims:"*) ;; *) PATH="$PATH:$HOME/.local/share/mise/shims" ;; esac
export PATH
command -v mise >/dev/null && eval "$(mise activate bash --shims)"
